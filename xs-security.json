{
  "xsappname": "mycapapp",
  "scopes": [
   
    {
      "name": "$XSAPPNAME.Display",
      "description": "Display"
    },
    {
      "name": "$XSAPPNAME.Edit",
      "description": "Edit"
    }
  ],
  "attributes": [
    {
      "name": "Country",
      "description": "Country",
      "valueType": "string"
    },
    {
      "name": "spiderman",
      "description": "Spiderman",
      "valueType": "string"
    }
  ],
  "role-templates": [
    {
      "name": "Viewer",
      "description": "View all employees data",
      "default-role-name": "Viewer: Authorized to Read All employee",
      "scope-references": [
        "$XSAPPNAME.Display"
      ],
      "attribute-references": [
        {
          "name": "spiderman"
        }
      ]
    },
    {
      "name": "Editor",
      "description": "Edit, delete employee data",
      "scope-references": [
        "$XSAPPNAME.Edit"
      ]
    }
  ],
  "role-collections": [
    {
      "name": "UserViewerRC",
      "description": "User Viewer Role Collection",
      "role-template-references": [
        "$XSAPPNAME.Viewer"
      ]
    }
  ],
  "authorities": [
    "$ACCEPT_GRANTED_AUTHORITIES"
  ],
  "oauth2-configuration": {
    "token-validity": 900,
    "redirect-uris": [
      "https://*.cfapps.us10-003.hana.ondemand.com/login/callback"
    ],
    "credential-types": [
      "binding-secret",
      "x509"
    ]
  },
  "xsenableasyncservice": "true"
}
